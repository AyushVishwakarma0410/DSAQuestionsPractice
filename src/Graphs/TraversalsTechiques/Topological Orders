# 💻 Java Implementation

```java
import java.util.*;

public class AllTopologicalSorts {

    static List<List<Integer>> result = new ArrayList<>();

    public static List<List<Integer>> allTopologicalSorts(int n, List<List<Integer>> graph) {

        int[] indegree = new int[n];
        boolean[] visited = new boolean[n];

        // compute indegree
        for (int i = 0; i < n; i++) {
            for (int nei : graph.get(i)) {
                indegree[nei]++;
            }
        }

        List<Integer> path = new ArrayList<>();

        dfs(graph, indegree, visited, path, n);

        return result;
    }

    private static void dfs(List<List<Integer>> graph,
                            int[] indegree,
                            boolean[] visited,
                            List<Integer> path,
                            int n) {

        boolean found = false;

        for (int i = 0; i < n; i++) {

            if (!visited[i] && indegree[i] == 0) {

                // choose
                visited[i] = true;
                path.add(i);

                for (int nei : graph.get(i)) {
                    indegree[nei]--;
                }

                dfs(graph, indegree, visited, path, n);

                // backtrack
                visited[i] = false;
                path.remove(path.size() - 1);

                for (int nei : graph.get(i)) {
                    indegree[nei]++;
                }

                found = true;
            }
        }

        // If no node was chosen and path is complete
        if (!found && path.size() == n) {
            result.add(new ArrayList<>(path));
        }
    }

    // helper to build graph
    public static List<List<Integer>> buildGraph(int n, int[][] edges) {

        List<List<Integer>> graph = new ArrayList<>();

        for (int i = 0; i < n; i++) {
            graph.add(new ArrayList<>());
        }

        for (int[] e : edges) {
            graph.get(e[0]).add(e[1]);
        }

        return graph;
    }
}
```

